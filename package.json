{
  "name": "go-sonar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "build:analyzer": "node scripts/build-analyzer.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" scripts/build-analyzer.mjs *.json *.ts src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.0.0",
    "elkjs": "^0.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
